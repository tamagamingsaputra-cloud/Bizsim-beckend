# ============================================================
# BizSim Backend — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Database
# Supported: sqlite | mysql | postgres
# Only "sqlite" runs out of the box (built on Node's native node:sqlite,
# no npm install needed). mysql/postgres require installing driver
# packages yourself (mysql2 / pg) — see backend/README.md.
DB_CLIENT=sqlite
SQLITE_PATH=./data/bizsim.db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bizsim
DB_PASSWORD=change_me
DB_NAME=bizsim

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_SALT_BYTES=16

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=8

# Seed admin account created on first migrate (change immediately after first login)
SEED_ADMIN_EMAIL=admin@bizsim.local
SEED_ADMIN_PASSWORD=ChangeMe123!
